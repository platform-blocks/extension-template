{
  "name": "platform-blocks-extension-template",
  "version": "1.0.0",
  "description": "Template for building a Platform Blocks extension",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/demos",
    "!**/meta"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "del-cli lib",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bob build"
  },
  "keywords": [
    "react-native",
    "platform-blocks",
    "platform-blocks-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platform-blocks/extension-template.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "@platform-blocks/ui": ">=1.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "del-cli": "^7.0.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "react-native-builder-bob": "^0.40.0",
    "react-test-renderer": "19.2.8",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@platform-blocks|@tabler/icons-react-native|@shopify/flash-list|react-native-reanimated-carousel))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "resolver": "react-native-worklets/jest/resolver.js"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}